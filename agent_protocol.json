{
  "schema": "https://github.com/YusufEminoglu/02Agent-OSM-Downloader/blob/main/AGENT_PROTOCOL.md",
  "protocol_id": "org.planx.qgis.processing-agent",
  "protocol_version": "1.0",
  "package_name": "zero2agent_osm_downloader",
  "provider_id": "zero2agentosm",
  "transport": "qgis_processing_registry",
  "discovery": {
    "plugin_tool": "plugin.capabilities",
    "plugin_argument": {
      "package_name": "zero2agent_osm_downloader"
    },
    "algorithm_search_tool": "processing.search",
    "algorithm_contract_tool": "processing.describe"
  },
  "execution": {
    "proposal_kind": "processing_run",
    "assistant_text_required": true,
    "fresh_context_token_required": true,
    "explicit_user_approval_required": true,
    "outputs": "temporary_qgis_layers_only"
  },
  "algorithms": [
    {
      "id": "zero2agentosm:download_preset",
      "operation": "download_curated_osm_theme",
      "parameters": {
        "PRESET": "multi_enum_from_live_algorithm",
        "EXTENT": [
          "map_extent",
          "layer_extent"
        ],
        "EXCLUDE_KEY": "validated_osm_tag_or_blank",
        "EXCLUDE_VALUE": "validated_osm_tag_or_blank",
        "OUTPUT_POINTS": "temporary_output",
        "OUTPUT_LINES": "temporary_output",
        "OUTPUT_POLYGONS": "temporary_output"
      },
      "notes": "EXCLUDE_KEY/EXCLUDE_VALUE are optional and shared by all four endpoints: when EXCLUDE_KEY is set, any fetched feature carrying that tag (any value, or the given value only) is dropped after the OSM response arrives — this is a client-side filter, not part of the Overpass query text."
    },
    {
      "id": "zero2agentosm:download_place",
      "operation": "download_curated_osm_datasets_for_place",
      "parameters": {
        "PLACE": "validated_place_name",
        "CLIP": "enum_from_live_algorithm",
        "AREA_ID": "validated_osm_area_id_or_blank",
        "PRESET": "multi_enum_from_live_algorithm",
        "EXTENT": [
          "map_extent",
          "layer_extent",
          "resolved_place_extent"
        ],
        "EXCLUDE_KEY": "validated_osm_tag_or_blank",
        "EXCLUDE_VALUE": "validated_osm_tag_or_blank",
        "OUTPUT_POINTS": "temporary_output",
        "OUTPUT_LINES": "temporary_output",
        "OUTPUT_POLYGONS": "temporary_output"
      },
      "notes": "PLACE is resolved with the OpenStreetMap Nominatim geocoder. CLIP 0 follows the mapped boundary, CLIP 1 uses the rectangular extent. AREA_ID accepts an already resolved Overpass area id so a chosen place is not geocoded a second time. EXTENT is required in every case: an area carries no size of its own, so a boundary request is filtered by the extent as well and the job area ceiling applies to it. When AREA_ID is blank the name is geocoded and EXTENT is replaced by the resolved place's rectangle. EXCLUDE_KEY/EXCLUDE_VALUE behave as on download_preset."
    },
    {
      "id": "zero2agentosm:download_custom_tag",
      "operation": "download_bounded_osm_tag",
      "parameters": {
        "KEY": "validated_osm_tag",
        "VALUE": "validated_osm_tag_or_blank",
        "GEOMETRY": "enum_from_live_algorithm",
        "EXTENT": [
          "map_extent",
          "layer_extent"
        ],
        "EXCLUDE_KEY": "validated_osm_tag_or_blank",
        "EXCLUDE_VALUE": "validated_osm_tag_or_blank",
        "OUTPUT_POINTS": "temporary_output",
        "OUTPUT_LINES": "temporary_output",
        "OUTPUT_POLYGONS": "temporary_output"
      },
      "notes": "EXCLUDE_KEY/EXCLUDE_VALUE behave as on download_preset."
    },
    {
      "id": "zero2agentosm:download_advanced",
      "operation": "download_structured_advanced_osm_tags",
      "parameters": {
        "MATCH_MODE": "enum_from_live_algorithm",
        "GEOMETRY": "enum_from_live_algorithm",
        "VALUE_MODE": "boolean_regex_instead_of_exact",
        "KEY_1..KEY_6": "validated_osm_tag_or_blank",
        "VALUE_1..VALUE_6": "validated_osm_tag_or_blank",
        "EXTENT": [
          "map_extent",
          "layer_extent"
        ],
        "EXCLUDE_KEY": "validated_osm_tag_or_blank",
        "EXCLUDE_VALUE": "validated_osm_tag_or_blank",
        "OUTPUT_POINTS": "temporary_output",
        "OUTPUT_LINES": "temporary_output",
        "OUTPUT_POLYGONS": "temporary_output"
      },
      "notes": "VALUE_MODE true renders every filled VALUE_N as an Overpass regex (~) selector instead of an exact-match (=) one; regex values still cannot contain quotes, backslashes or semicolons. EXCLUDE_KEY/EXCLUDE_VALUE behave as on download_preset."
    }
  ],
  "safety": {
    "network_access": "pinned_overpass_mirrors_and_nominatim_only",
    "network_hosts": [
      "overpass-api.de",
      "overpass.kumi.systems",
      "overpass.private.coffee",
      "nominatim.openstreetmap.org"
    ],
    "maximum_extent_area_km2": 2500,
    "maximum_single_request_area_km2": 100,
    "maximum_requests_per_download": 40,
    "maximum_merged_features": 400000,
    "maximum_advanced_tag_filters": 6,
    "maximum_datasets_per_request": 32,
    "advanced_match_modes": [
      "any",
      "all"
    ],
    "raw_query_input": false,
    "arbitrary_url_input": false,
    "file_path_input": false,
    "api_key_input": false
  }
}
